{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dossier de recherche sourcé",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resume",
    "faits",
    "chiffres",
    "contradictions",
    "angles",
    "a_verifier"
  ],
  "properties": {
    "resume": {"type": "string", "minLength": 20, "maxLength": 1800},
    "faits": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["affirmation", "precision", "sources"],
        "properties": {
          "affirmation": {"type": "string", "minLength": 5, "maxLength": 400},
          "precision": {"type": "string", "minLength": 0, "maxLength": 400},
          "sources": {
            "type": "array",
            "maxItems": 6,
            "items": {"type": "string", "pattern": "^[WS][0-9]{1,2}$"}
          }
        }
      }
    },
    "chiffres": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["valeur", "contexte", "sources"],
        "properties": {
          "valeur": {"type": "string", "minLength": 1, "maxLength": 120},
          "contexte": {"type": "string", "minLength": 3, "maxLength": 400},
          "sources": {
            "type": "array",
            "maxItems": 6,
            "items": {"type": "string", "pattern": "^[WS][0-9]{1,2}$"}
          }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point", "explication", "sources"],
        "properties": {
          "point": {"type": "string", "minLength": 3, "maxLength": 240},
          "explication": {"type": "string", "minLength": 5, "maxLength": 700},
          "sources": {
            "type": "array",
            "maxItems": 6,
            "items": {"type": "string", "pattern": "^[WS][0-9]{1,2}$"}
          }
        }
      }
    },
    "angles": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["titre", "angle", "pourquoi", "sources"],
        "properties": {
          "titre": {"type": "string", "minLength": 8, "maxLength": 160},
          "angle": {"type": "string", "minLength": 10, "maxLength": 500},
          "pourquoi": {"type": "string", "minLength": 10, "maxLength": 500},
          "sources": {
            "type": "array",
            "maxItems": 6,
            "items": {"type": "string", "pattern": "^[WS][0-9]{1,2}$"}
          }
        }
      }
    },
    "a_verifier": {
      "type": "array",
      "maxItems": 12,
      "items": {"type": "string", "minLength": 5, "maxLength": 400}
    }
  }
}
