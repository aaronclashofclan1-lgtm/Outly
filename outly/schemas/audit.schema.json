{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit de chaîne et stratégie de contenu",
  "type": "object",
  "additionalProperties": false,
  "required": ["secteur", "diagnostic", "concurrents", "strategie", "idees"],
  "properties": {
    "secteur": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secteur", "sous_niche", "audience", "promesse", "formats", "langue"],
      "properties": {
        "secteur": {"type": "string", "minLength": 3, "maxLength": 160},
        "sous_niche": {"type": "string", "minLength": 2, "maxLength": 200},
        "audience": {"type": "string", "minLength": 5, "maxLength": 300},
        "promesse": {"type": "string", "minLength": 5, "maxLength": 300},
        "formats": {"type": "string", "minLength": 2, "maxLength": 200},
        "langue": {"type": "string", "minLength": 2, "maxLength": 80}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forces", "faiblesses", "opportunites"],
      "properties": {
        "forces": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/constat"}},
        "faiblesses": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/constat"}},
        "opportunites": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/constat"}}
      }
    },
    "concurrents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paysage", "pratiques", "manques"],
      "properties": {
        "paysage": {"type": "string", "minLength": 20, "maxLength": 1200},
        "pratiques": {
          "type": "array", "minItems": 1, "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pratique", "exemples", "pourquoi_ca_marche"],
            "properties": {
              "pratique": {"type": "string", "minLength": 5, "maxLength": 300},
              "exemples": {"type": "string", "minLength": 5, "maxLength": 600},
              "pourquoi_ca_marche": {"type": "string", "minLength": 5, "maxLength": 600}
            }
          }
        },
        "manques": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "minLength": 3, "maxLength": 400}}
      }
    },
    "strategie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positionnement", "promesse", "piliers", "formats", "cadence", "series", "premiers_30_jours", "kpis"],
      "properties": {
        "positionnement": {"type": "string", "minLength": 15, "maxLength": 900},
        "promesse": {"type": "string", "minLength": 5, "maxLength": 600},
        "piliers": {
          "type": "array", "minItems": 1, "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nom", "promesse", "formats", "exemples_de_titres"],
            "properties": {
              "nom": {"type": "string", "minLength": 2, "maxLength": 120},
              "promesse": {"type": "string", "minLength": 5, "maxLength": 500},
              "formats": {"type": "string", "minLength": 2, "maxLength": 300},
              "exemples_de_titres": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 5, "maxLength": 140}}
            }
          }
        },
        "formats": {
          "type": "array", "minItems": 1, "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "frequence", "objectif"],
            "properties": {
              "format": {"type": "string", "minLength": 2, "maxLength": 120},
              "frequence": {"type": "string", "minLength": 2, "maxLength": 160},
              "objectif": {"type": "string", "minLength": 3, "maxLength": 300}
            }
          }
        },
        "cadence": {"type": "string", "minLength": 3, "maxLength": 300},
        "series": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "minLength": 3, "maxLength": 300}},
        "premiers_30_jours": {
          "type": "array", "minItems": 2, "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["semaine", "objectif", "actions"],
            "properties": {
              "semaine": {"type": "string", "minLength": 2, "maxLength": 120},
              "objectif": {"type": "string", "minLength": 3, "maxLength": 300},
              "actions": {"type": "string", "minLength": 5, "maxLength": 700}
            }
          }
        },
        "kpis": {
          "type": "array", "minItems": 2, "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["indicateur", "cible", "pourquoi"],
            "properties": {
              "indicateur": {"type": "string", "minLength": 2, "maxLength": 120},
              "cible": {"type": "string", "minLength": 1, "maxLength": 160},
              "pourquoi": {"type": "string", "minLength": 3, "maxLength": 400}
            }
          }
        }
      }
    },
    "idees": {
      "type": "array", "minItems": 3, "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["titre", "angle", "pourquoi", "format"],
        "properties": {
          "titre": {"type": "string", "minLength": 8, "maxLength": 140},
          "angle": {"type": "string", "minLength": 5, "maxLength": 400},
          "pourquoi": {"type": "string", "minLength": 5, "maxLength": 600},
          "format": {"type": "string", "minLength": 2, "maxLength": 80}
        }
      }
    },
    "limites": {"type": "array", "maxItems": 6, "items": {"type": "string", "minLength": 3, "maxLength": 400}}
  },
  "$defs": {
    "constat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constat", "preuve"],
      "properties": {
        "constat": {"type": "string", "minLength": 5, "maxLength": 300},
        "preuve": {"type": "string", "minLength": 3, "maxLength": 400}
      }
    }
  }
}
