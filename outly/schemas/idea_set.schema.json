{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["introduction", "idees"],
  "properties": {
    "introduction": {
      "type": "string",
      "minLength": 40,
      "maxLength": 1200
    },
    "idees": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sujet", "type", "pourquoi", "sources", "angles"],
        "properties": {
          "sujet": {"type": "string", "minLength": 8, "maxLength": 180},
          "type": {"type": "string", "enum": ["sujet", "concept"]},
          "pourquoi": {"type": "string", "minLength": 30, "maxLength": 700},
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {"type": "string", "minLength": 2, "maxLength": 160}
          },
          "notes": {
            "type": "array",
            "maxItems": 4,
            "items": {"type": "string", "minLength": 1, "maxLength": 20}
          },
          "angles": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["angle", "titre"],
              "properties": {
                "angle": {"type": "string", "minLength": 3, "maxLength": 80},
                "titre": {"type": "string", "minLength": 8, "maxLength": 140}
              }
            }
          }
        }
      }
    }
  }
}
