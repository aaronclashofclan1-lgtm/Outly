{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["synthese", "angles", "sujets", "questions"],
  "properties": {
    "synthese": {
      "type": "string",
      "minLength": 60,
      "maxLength": 1600
    },
    "angles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["titre", "promesse", "hook", "pourquoi", "notes"],
        "properties": {
          "titre": {"type": "string", "minLength": 5, "maxLength": 140},
          "promesse": {"type": "string", "minLength": 10, "maxLength": 500},
          "hook": {"type": "string", "minLength": 10, "maxLength": 700},
          "pourquoi": {"type": "string", "minLength": 20, "maxLength": 600},
          "notes": {
            "type": "array",
            "maxItems": 4,
            "items": {"type": "string", "minLength": 1, "maxLength": 20}
          }
        }
      }
    },
    "sujets": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["titre", "angle", "notes"],
        "properties": {
          "titre": {"type": "string", "minLength": 5, "maxLength": 140},
          "angle": {"type": "string", "minLength": 10, "maxLength": 500},
          "notes": {
            "type": "array",
            "maxItems": 4,
            "items": {"type": "string", "minLength": 1, "maxLength": 20}
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "minLength": 10, "maxLength": 300}
    },
    "liens": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["notes", "idee"],
        "properties": {
          "notes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {"type": "string", "minLength": 1, "maxLength": 20}
          },
          "idee": {"type": "string", "minLength": 15, "maxLength": 600}
        }
      }
    }
  }
}
