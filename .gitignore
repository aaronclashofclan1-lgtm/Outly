# Secrets - never commit
.env
.env.*
!.env.example

# Local data and generated output
data/
out/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.log
data/*.json

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Packaged/personal folders from the original author's workspace
Outly-app/
Outly-partage/
Application Outly/
Outly-source.zip
_comparateur.png
