# ===========================================================================
# Outly secrets and endpoints
# Copy this file to .env and fill in your own keys. NEVER commit .env.
# ===========================================================================

# --- YouTube Data API v3 -----------------------------------------------
# One key, one Google Cloud project. Sharing quota across projects is
# prohibited by the YouTube Developer Policies.
# Console: https://console.cloud.google.com/
YOUTUBE_API_KEY=replace_with_your_youtube_api_key

# --- Primary LLM -------------------------------------------------------
# Any provider exposing the OpenAI Chat Completions API.
# Gemini free tier:
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=replace_with_your_llm_api_key

# Alternatives, same three variables:
#   Groq         -> https://api.groq.com/openai/v1   / openai/gpt-oss-20b
#   Mistral      -> https://api.mistral.ai/v1        / ministral-8b-latest
#   Ollama Cloud -> https://ollama.com/v1            / gemma4:31b  (key required)
#   Ollama local -> http://localhost:11434/v1        / gpt-oss:20b (empty key)
# Verify the exact model name with: python -m outly doctor --probe

# --- Web research with AI (Exa) ---------------------------------------
# Optional. Used only by the Research page in "With AI" mode.
# Create a key at https://dashboard.exa.ai/api-keys. Leave empty to keep
# the "No AI" mode, which queries Wikipedia only.
EXA_API_KEY=

# --- YouTube Studio (retention, audience, impressions) -----------------
# Filled by the Studio YouTube page after "Connect my channel".
# Create a Desktop OAuth client in Google Cloud with YouTube Data API v3
# and YouTube Analytics API enabled. Only a refresh token is stored here.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Email reports -----------------------------------------------------
# Reports always leave from outly.analyze@gmail.com (Gmail, STARTTLS).
# Only the app password belongs here:
# https://myaccount.google.com/apppasswords
# Two-factor authentication is required; never use the account password.
SMTP_PASSWORD=

# --- Fallback LLM (optional) -------------------------------------------
# Used automatically when the primary provider keeps returning rate limits.
# Leave empty to disable fallback.
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_API_KEY=
